# Xcode
build/
DerivedData/
*.xcuserstate
*.xcscmblueprint
xcuserdata/

# Swift Package Manager
.build/
.swiftpm/

# Test output
*.xcresult
TestResults/

# macOS
.DS_Store

# Rendered by Bar/screen-context/harness/frame-hash.mjs with KEEP=1 (30 MB)
Bar/screen-context/harness/frame-hash-out/

# Scratch from Bar/layouts/capture-rendered.sh (logs and per-run screenshots)
Bar/layouts/.capture/

# Generated by the typing harness; committed scores live in the README.
Bar/typing/engine_outputs.json

# Brainstorm/design session artifacts
.superpowers/

# wordfreq venv for Bar/grouped/make-lexicon.py (54 MB of data files)
Bar/grouped/.venv/

# wordfreq lexicons for Bar/grouped: 11.7 MB, license-encumbered (measurement
# only, never shippable) and regenerated by Bar/grouped/make-lexicon.py.
Bar/grouped/data/lexicon-*.json

# Bundled grouped-key word lists, written by Scripts/generate-grouped-lexicon.py
# from wordfreq. Its code is Apache 2.0 but its data is drawn from corpora with
# mixed and partly unstated licences, so these are measurement/development only
# and must not ship until a licence is settled. GroupedLexiconResource reports
# .seedOnly when they are absent, which is the state of a fresh checkout.
Packages/AIKeyboardCore/Sources/AIKeyboardCore/Resources/GroupedLexicon-*.txt
