require "json"
require "open3"

repo_root = File.expand_path("..", __dir__)
release = JSON.parse(File.read(File.join(repo_root, "AppStore/release.json")))

default_platform(:ios)

platform :ios do
  private_lane :local_app_store_connect_key do
    key_id = ENV.fetch("ASC_KEY_ID", "39J453KSX8")
    issuer_id, status = Open3.capture2(
      "security",
      "find-generic-password",
      "-s", "asc-api-issuer",
      "-a", key_id,
      "-w"
    )
    UI.user_error!("App Store Connect issuer is missing from Keychain") unless status.success?

    key_path = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")
    UI.user_error!("App Store Connect private key file is missing") unless File.file?(key_path)

    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id.strip,
      key_filepath: key_path,
      in_house: false
    )
  end

  desc "Apply public App Store metadata and screenshots only."
  lane :apply_store_listing do
    # Deliver's legacy uploader can retry while Apple's first copy is still
    # processing and create duplicates. Its checksum-based sync path is
    # idempotent, which is what a repeatable release command needs.
    ENV["FASTLANE_ENABLE_BETA_DELIVER_SYNC_SCREENSHOTS"] = "true"
    deliver(
      api_key: local_app_store_connect_key,
      app_identifier: release.fetch("app").fetch("bundleId"),
      app_version: release.fetch("app").fetch("version"),
      metadata_path: File.join(repo_root, "fastlane/metadata"),
      screenshots_path: File.join(repo_root, "fastlane/screenshots"),
      copyright: release.fetch("release").fetch("copyright"),
      primary_category: release.fetch("release").fetch("primaryCategory").upcase,
      secondary_category: release.fetch("release").fetch("secondaryCategory").upcase,
      skip_binary_upload: true,
      submit_for_review: false,
      skip_metadata: false,
      skip_screenshots: false,
      sync_screenshots: true,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end
end
